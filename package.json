{
  "name": "my-shop-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first retail point of sale for a grocery shop",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/local.mjs",
    "build": "electron-vite build",
    "local": "node scripts/local.mjs",
    "build:local": "tsc -p tsconfig.server.json && vite --config vite.local.config.ts build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.58.1",
    "react-router-dom": "^7.6.2",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^45.1.0",
    "electron-vite": "^3.1.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  }
}
